# Copy this file to .env.local and fill in real values for local development.

# PostgreSQL connection string.
# docker compose up -d   # starts a local dev database on port 5442
DATABASE_URL="postgresql://aurel:aurel_dev_password@localhost:5442/aurel"

# Auth.js. Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Google Maps (Places Autocomplete, route preview/distance). When unset, the
# booking flow falls back to a clearly labeled manual-entry/demo mode instead
# of pretending to be live Google Maps data.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Stripe test mode keys. When unset, checkout runs in a clearly labeled mock
# payment mode instead of a real Stripe test charge.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Transactional email. When unset, notifications are logged to the server
# console instead of a real send.
RESEND_API_KEY=""
EMAIL_FROM="AUREL <no-reply@aurel.example>"
